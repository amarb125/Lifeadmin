# ---- Everything below is optional. With none of it set, LifePilot runs in DEMO MODE (data stays in this browser). ----

# AI task extraction (server-only). Without it the built-in rule-based parser is used.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Voice fallback for browsers without the Web Speech API (server-only)
OPENAI_API_KEY=
# TRANSCRIBE_MODEL=whisper-1

# Supabase: accounts, storage, server-side reminders
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only — never prefix with NEXT_PUBLIC_

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                # server-only
VAPID_SUBJECT=mailto:you@example.com

# Protects /api/cron/reminders. Vercel Cron sends it automatically as "Authorization: Bearer <value>".
CRON_SECRET=
